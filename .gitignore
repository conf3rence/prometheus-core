# Виртуальное окружение Python
venv/
env/
.venv/

# Кэш Python (чтобы не засорять репозиторий)
__pycache__/
*.pyc
*.pyo
*.pyd

# Папки сборки PyInstaller (они создаются заново при билде)
build/
dist/
*.spec

# Результаты работы программы (логи, графики, сохраненные картинки)
output/

# Файлы IDE / редакторов
.vscode/
.idea/

# Системный мусор (Windows/Mac)
.DS_Store
Thumbs.db